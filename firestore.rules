rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserId() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(currentUserId())) &&
             get(/databases/$(database)/documents/users/$(currentUserId())).data.get('isAdmin', false) == true;
    }

    function isSelfDoc(docId) {
      return isAuthenticated() && docId == currentUserId();
    }

    function isParticipant(chatId) {
      return isAuthenticated() &&
          (currentUserId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
           normalizedUserId() in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
    }

    function isParticipantData(data) {
      return isAuthenticated() &&
          (currentUserId() in data.participants ||
           normalizedUserId() in data.participants);
    }

    function hasValidChatParticipants(data) {
      return data.participants is list &&
          data.participants.size() == 2 &&
          data.participants[0] is string &&
          data.participants[1] is string &&
          data.participants[0] != data.participants[1];
    }

    function isChatPayloadShapeValid(data) {
      return data.keys().hasOnly([
        'participants',
        'participantMeta',
        'chatType',
        'referenceId',
        'listingTitle',
        'lastMessage',
        'lastMessageType',
        'lastMessageTime',
        'lastSenderId',
        'lastReadAt',
        'unreadCountByUser',
        'typingByUser',
        'hiddenBy',
        'referenceDeleted',
        'referenceDeletedAt',
        'createdAt',
      ]) &&
          hasValidChatParticipants(data) &&
          (!('participantMeta' in data) || data.participantMeta is map) &&
          data.chatType in ['listing', 'marketplace'] &&
          data.referenceId is string &&
          (!('listingTitle' in data) || data.listingTitle is string) &&
          data.lastMessage is string &&
          (!('lastMessageType' in data) || data.lastMessageType in ['text']) &&
          data.lastSenderId is string &&
          data.lastReadAt is map &&
          (!('unreadCountByUser' in data) || data.unreadCountByUser is map) &&
          (!('typingByUser' in data) || data.typingByUser is map) &&
          isValidHiddenByField(data) &&
          isValidReferenceDeletionFields(data) &&
          isValidReferenceDeletedAtField(data);
    }

    function isValidMessagePayload(data) {
      return data.keys().hasOnly([
        'clientId',
        'senderId',
        'receiverId',
        'text',
        'timestamp',
        'status',
      ]) &&
          (!('clientId' in data) || data.clientId is string) &&
          data.senderId is string &&
          data.receiverId is string &&
          data.text is string &&
          data.timestamp is timestamp &&
          data.status in ['sent', 'read'];
    }

    function normalizeUid(value) {
      let parts = value.split('_');
      return parts.size() > 1 ? parts[parts.size() - 1] : value;
    }

    function isParticipantId(value, participants) {
      return value in participants || normalizeUid(value) in participants;
    }

    function isValidHiddenByField(data) {
      return !('hiddenBy' in data) || (
        data.hiddenBy is list &&
        data.hiddenBy.size() <= 2 &&
        (data.hiddenBy.size() == 0 || data.hiddenBy[0] is string) &&
        (data.hiddenBy.size() < 2 || data.hiddenBy[1] is string) &&
        (data.hiddenBy.size() == 0 || isParticipantId(data.hiddenBy[0], data.participants)) &&
        (data.hiddenBy.size() < 2 || isParticipantId(data.hiddenBy[1], data.participants))
      );
    }

    function isValidHiddenByUpdate(requestData, oldData) {
      return requestData.participants == oldData.participants &&
          requestData.participantMeta == oldData.participantMeta &&
          requestData.chatType == oldData.chatType &&
          requestData.referenceId == oldData.referenceId &&
          requestData.listingTitle == oldData.listingTitle &&
          requestData.lastMessage == oldData.lastMessage &&
          requestData.lastMessageType == oldData.lastMessageType &&
          requestData.lastMessageTime == oldData.lastMessageTime &&
          requestData.lastSenderId == oldData.lastSenderId &&
          requestData.lastReadAt == oldData.lastReadAt &&
          requestData.unreadCountByUser == oldData.unreadCountByUser &&
          requestData.typingByUser == oldData.typingByUser &&
          requestData.createdAt == oldData.createdAt &&
          ( !('referenceDeleted' in requestData) || requestData.referenceDeleted == oldData.referenceDeleted ) &&
          ( !('referenceDeletedAt' in requestData) || requestData.referenceDeletedAt == oldData.referenceDeletedAt ) &&
          isValidHiddenByField(requestData);
    }

    function isValidReferenceDeletionFields(data) {
      return !('referenceDeleted' in data) || data.referenceDeleted is bool;
    }

    function isValidReferenceDeletedAtField(data) {
      return !('referenceDeletedAt' in data) || data.referenceDeletedAt is timestamp;
    }

    function normalizedUserId() {
      let parts = currentUserId().split('_');
      return parts.size() > 1 ? parts[parts.size() - 1] : currentUserId();
    }

    function isOwnerByUidField() {
      return isAuthenticated() && resource.data.uid == currentUserId();
    }

    function isOwnerByUserIdField() {
      return isAuthenticated() && resource.data.userId == currentUserId();
    }

    function isOwnerByOwnerIdField() {
      return isAuthenticated() && resource.data.ownerId == currentUserId();
    }

    function isValidOptionalString(data, key) {
      return !(key in data) || data[key] == null || data[key] is string;
    }

    function isValidOptionalNumber(data, key) {
      return !(key in data) || data[key] == null || data[key] is number;
    }

    function isValidOptionalStringList(data, key) {
      return !(key in data) || data[key] is list;
    }

    function isValidListingCombination(data) {
      return (data.type == 'marketplace' &&
              data.propertyType == 'item' &&
              data.purpose == 'marketplaceSell') ||
          (data.type == 'housing' &&
              data.propertyType in ['room', 'flat', 'pg'] &&
              data.purpose in ['needPlace', 'needRoommate', 'offerProperty'] &&
              (data.purpose != 'needRoommate' ||
                  data.propertyType in ['room', 'flat']));
    }

    function isValidRequirementDetails(data) {
      return !('requirementDetails' in data) ||
          (data.requirementDetails is map &&
              data.requirementDetails.keys().hasOnly([
                'userId',
                'needType',
                'location',
                'minBudget',
                'maxBudget',
                'moveInWhen',
                'occupancy',
                'genderPreference',
                'description',
                'amenities',
                'lifestyle',
                'contactMethods',
              ]) &&
              data.requirementDetails.userId is string &&
              data.requirementDetails.needType in ['room', 'flat', 'pg', 'hostel'] &&
              data.requirementDetails.location is string &&
              data.requirementDetails.minBudget is number &&
              data.requirementDetails.maxBudget is number &&
              data.requirementDetails.minBudget <= data.requirementDetails.maxBudget &&
              data.requirementDetails.moveInWhen is string &&
              data.requirementDetails.occupancy is string &&
              data.requirementDetails.genderPreference is string &&
              data.requirementDetails.description is string &&
              data.requirementDetails.amenities is list &&
              data.requirementDetails.lifestyle is list &&
              data.requirementDetails.contactMethods is list);
    }

    function isValidListingPayload(data) {
      return data.keys().hasOnly([
        'ownerId',
        'ownerName',
        'ownerPhotoUrl',
        'title',
        'description',
        'location',
        'latitude',
        'longitude',
        'price',
        'type',
        'propertyType',
        'purpose',
        'requirementDetails',
        'imageUrls',
        'highlights',
        'genderPreference',
        'condition',
        'furnishing',
        'availableFrom',
        'isFeatured',
        'phonePublic',
        'isApproved',
        'createdAt',
      ]) &&
          data.ownerId is string &&
          data.ownerName is string &&
          data.ownerPhotoUrl is string &&
          data.title is string &&
          data.title.size() > 0 &&
          data.description is string &&
          data.description.size() > 0 &&
          data.location is string &&
          data.location.size() > 0 &&
          isValidOptionalNumber(data, 'latitude') &&
          isValidOptionalNumber(data, 'longitude') &&
          data.price is number &&
          data.type in ['housing', 'marketplace'] &&
          data.propertyType in ['room', 'pg', 'flat', 'item'] &&
          data.purpose in ['needPlace', 'needRoommate', 'offerProperty', 'marketplaceSell'] &&
          isValidListingCombination(data) &&
          isValidRequirementDetails(data) &&
          data.imageUrls is list &&
          data.highlights is list &&
          isValidOptionalString(data, 'genderPreference') &&
          isValidOptionalString(data, 'condition') &&
          isValidOptionalString(data, 'furnishing') &&
          isValidOptionalString(data, 'availableFrom') &&
          (!('isFeatured' in data) || data.isFeatured is bool) &&
          (!('phonePublic' in data) || data.phonePublic is bool) &&
          (!('isApproved' in data) || data.isApproved is bool);
    }

    match /users/{userId} {
      allow read: if isSelfDoc(userId) || isAdmin();

      allow create: if isSelfDoc(userId) &&
          request.resource.data.get('uid', currentUserId()) == currentUserId() &&
          request.resource.data.get('isAdmin', false) == false;

      allow update: if (isSelfDoc(userId) &&
          request.resource.data.get('uid', currentUserId()) == currentUserId() &&
          request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)) || isAdmin();

      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
          isValidListingPayload(request.resource.data) &&
          request.resource.data.ownerId == currentUserId() &&
          request.resource.data.ownerName is string &&
          request.resource.data.get('isApproved', false) == false;

      allow update: if isAdmin() || (isOwnerByOwnerIdField() &&
          isValidListingPayload(request.resource.data) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.get('createdAt', resource.data.createdAt) == resource.data.createdAt &&
          request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false));

      allow delete: if isAdmin() || isOwnerByOwnerIdField();
    }

    match /chats/{chatId} {
      allow read: if isParticipantData(resource.data);

      allow create: if isAuthenticated() &&
          isChatPayloadShapeValid(request.resource.data) &&
          (currentUserId() in request.resource.data.participants ||
           normalizedUserId() in request.resource.data.participants);

      allow update: if isParticipantData(resource.data) && (
            (isChatPayloadShapeValid(request.resource.data) &&
              request.resource.data.participants == resource.data.participants &&
              request.resource.data.chatType == resource.data.chatType &&
              request.resource.data.referenceId == resource.data.referenceId &&
              request.resource.data.createdAt == resource.data.createdAt)
            ||
            isValidHiddenByUpdate(request.resource.data, resource.data)
          );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);

        allow create: if isAuthenticated() &&
            isValidMessagePayload(request.resource.data) &&
            (request.auth.uid == request.resource.data.senderId || normalizedUserId() == request.resource.data.senderId) &&
            isParticipant(chatId) &&
            request.resource.data.receiverId in
                get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
            request.resource.data.receiverId != request.auth.uid &&
            request.resource.data.receiverId != normalizedUserId();

        allow update: if isAuthenticated() &&
            (request.auth.uid == resource.data.receiverId || normalizedUserId() == resource.data.receiverId) &&
            isParticipant(chatId) &&
            isValidMessagePayload(request.resource.data) &&
            request.resource.data.status == 'read' &&
            request.resource.data.get('clientId', '') == resource.data.get('clientId', '') &&
            request.resource.data.senderId == resource.data.senderId &&
            request.resource.data.receiverId == resource.data.receiverId &&
            request.resource.data.text == resource.data.text &&
            request.resource.data.timestamp == resource.data.timestamp;

        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
